    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "debugger": {
    "dock": "bottom"
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "sidebar_side": "right",
    "use_modifier_to_send": true,
    "terminal_init_command": "",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "write",
    "profiles": {
      "all": {
        "name": "all",
        "tools": {
          "write_file": true,
          "terminal": true,
          "spawn_agent": true,
          "read_file": true,
          "skill": true,
          "move_path": true,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "fetch": true,
          "edit_file": true,
          "diagnostics": true,
          "delete_path": true,
          "create_directory": true,
          "copy_path": true,
          "ask_user": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
      "enable_thinking": false
    },
    "thinking_display": "auto",
    "play_sound_when_agent_done": "always",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1",
    },
    "notify_when_agent_waiting": "all_screens",
    "flexible": true,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "commit_message_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:1.5b-base"
    }
  },
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "One Dark"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "project_panel": {
    "dock": "left"
  },
  "tabs": {
    "close_position": "right"
  },
  "remove_trailing_whitespace_on_save": false,
  "ensure_final_newline_on_save": false,
  "context_servers": {
    "icm": {
      "command": "/home/abueno@airzonesl.es/.local/bin/icm",
      "args": [
        "serve"
      ],
      "env": {}
    }
  },
  "git_hosting_providers": [
    {
      "provider": "gitlab",
      "name": "Airzone GitLab",
      "base_url": "http://gitlab2.airzonesl.es:30080/"
    }
  ],
  "edit_predictions": {
    "provider": "copilot",
  },
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "model": [
          "opus[1m]",
          "claude-fable-5[1m]"
        ],
        "mode": [
          "bypassPermissions"
        ]
      },
      "default_config_options": {
        "ultracode": false,
        "fast": false,
        "model": "opus[1m]",
        "mode": "bypassPermissions"
      },
      "type": "registry"
    }
  },
  "double_click_in_multibuffer": "open",
  "base_keymap": "JetBrains",
  "autosave": "on_focus_change",
  "auto_update": true,
  "buffer_font_family": "JetBrainsMonoNL Nerd Font",
  "buffer_font_features": {
    "calt": false,
    "liga": false,
  },
  "buffer_font_size": 14.0,
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "imports": {
          "granularity": {
            "group": "item",
          },
        },
      },
    },
  },
  "format_on_save": "off",
  "inlay_hints": {
    "enabled": true,
  },
  "file_types": {
    "BitBake": [
      "**/conf/*.conf",
      "**/conf/distro/*.conf",
      "**/conf/machine/*.conf"
    ]
